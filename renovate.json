{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:allNonMajor"
  ],
  "schedule": [
    "* * * * 6"
  ],
  "assignees": [
    "jljl1337"
  ],
  "packageRules": [
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "docker.io/linuxserver/qbittorrent"
      ],
      "allowedVersions": "!/^(20\\.04\\.1|14\\.3\\.9)$/"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/immich-app/postgres"
      ],
      "enabled": false
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "docker.io/valkey/valkey"
      ],
      "enabled": false
    }
  ]
}
