{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.18.0/.schema/devbox.schema.json",
  "packages": [],
  "shell": {
    "init_hook": [
      "echo 'Welcome to devbox!' > /dev/null"
    ],
    "scripts": {
      "pull": [
        "sudo docker compose pull"
      ],
      "up": [
        "sudo docker compose up -d --remove-orphans"
      ],
      "down": [
        "sudo docker compose down --remove-orphans"
      ],
      "restart": [
        "sudo docker compose restart \"$@\""
      ],
      "wps": [
        "sudo watch -n 1 \"docker ps -a --format 'table {{.ID}}\t{{.Names}}\t{{.Image}}\t{{.RunningFor}}\t{{.Status}}'\""
      ],
      "ps": [
        "sudo docker ps -a --format 'table {{.ID}}\t{{.Names}}\t{{.Image}}\t{{.RunningFor}}\t{{.Status}}'"
      ],
      "logs": [
        "sudo docker compose logs -n 100 \"$@\""
      ],
      "wlogs": [
        "sudo docker compose logs -n 100 -f \"$@\""
      ],
      "smi": [
        "watch -n 1 nvidia-smi"
      ]
    }
  }
}
